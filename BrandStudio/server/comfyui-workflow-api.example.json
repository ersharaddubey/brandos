{
  "1": {
    "inputs": { "ckpt_name": "REPLACE_WITH_INSTALLED_CHECKPOINT.safetensors" },
    "class_type": "CheckpointLoaderSimple",
    "_meta": { "title": "Load Checkpoint" }
  },
  "2": {
    "inputs": { "text": "cinematic portrait, natural lighting, detailed, high quality", "clip": ["1", 1] },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Positive Prompt" }
  },
  "3": {
    "inputs": { "text": "low quality, blurry, distorted anatomy, extra fingers, watermark, text", "clip": ["1", 1] },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Negative Prompt" }
  },
  "4": {
    "inputs": {
      "seed": 123456789,
      "steps": 24,
      "cfg": 7,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1,
      "model": ["1", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["5", 0]
    },
    "class_type": "KSampler",
    "_meta": { "title": "Sample" }
  },
  "5": {
    "inputs": { "width": 1024, "height": 1024, "batch_size": 1 },
    "class_type": "EmptyLatentImage",
    "_meta": { "title": "Image Size" }
  },
  "6": {
    "inputs": { "samples": ["4", 0], "vae": ["1", 2] },
    "class_type": "VAEDecode",
    "_meta": { "title": "Decode Image" }
  },
  "7": {
    "inputs": { "filename_prefix": "CreativeIdentity", "images": ["6", 0] },
    "class_type": "SaveImage",
    "_meta": { "title": "Save Image" }
  }
}
