{
  "name": "brandstudio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "brandstudio \u2014 brandstudio Platform (Vercel: client static + /api serverless)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client install && npm --prefix client run build",
    "doctor": "npm --prefix server run doctor",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "qa:smoke": "node qa/scripts/run-qa.mjs",
    "qa:agent": "node qa/scripts/autonomous-qa.mjs",
    "qa:full": "npm run qa:smoke && npm run qa:agent",
    "qa:phase2": "node qa/scripts/phase2.mjs",
    "qa:all": "npm run qa:smoke && npm run qa:agent && npm run qa:phase2",
    "test:all": "node qa/scripts/test-all.mjs"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "@google/generative-ai": "^0.24.1",
    "@qdrant/js-client-rest": "^1.19.0",
    "@vercel/functions": "^2.0.0",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.0",
    "mongoose": "^8.7.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^7.39.0",
    "replicate": "^1.4.0",
    "sharp": "^0.35.5",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  },
  "overrides": {
    "undici": "$undici"
  }
}
