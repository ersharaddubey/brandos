{
  "1": {
    "inputs": { "ckpt_name": "REPLACE_WITH_INSTALLED_SDXL_CHECKPOINT.safetensors" },
    "class_type": "CheckpointLoaderSimple",
    "_meta": { "title": "Load SDXL Checkpoint" }
  },
  "2": {
    "inputs": { "text": "cinematic portrait, natural skin texture, consistent facial features, detailed, high quality", "clip": ["1", 1] },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Positive Prompt" }
  },
  "3": {
    "inputs": { "text": "low quality, blurry, distorted anatomy, extra fingers, watermark, text, duplicate face", "clip": ["1", 1] },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Negative Prompt" }
  },
  "4": {
    "inputs": {
      "seed": 123456789,
      "steps": 28,
      "cfg": 6.5,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1,
      "model": ["10", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["5", 0]
    },
    "class_type": "KSampler",
    "_meta": { "title": "Sample" }
  },
  "5": {
    "inputs": { "width": 1024, "height": 1024, "batch_size": 1 },
    "class_type": "EmptyLatentImage",
    "_meta": { "title": "Image Size" }
  },
  "6": {
    "inputs": { "samples": ["4", 0], "vae": ["1", 2] },
    "class_type": "VAEDecode",
    "_meta": { "title": "Decode Image" }
  },
  "7": {
    "inputs": { "filename_prefix": "CreativeIdentity_IPAdapter", "images": ["6", 0] },
    "class_type": "SaveImage",
    "_meta": { "title": "Save Image" }
  },
  "8": {
    "inputs": { "ipadapter_file": "ip-adapter-plus_sdxl_vit-h.safetensors" },
    "class_type": "IPAdapterModelLoader",
    "_meta": { "title": "Load IPAdapter Model" }
  },
  "9": {
    "inputs": { "image": "REPLACED_BY_CREATIVE_IDENTITY_UPLOAD.png" },
    "class_type": "LoadImage",
    "_meta": { "title": "Identity Reference Image" }
  },
  "10": {
    "inputs": {
      "weight": 0.75,
      "weight_type": "linear",
      "combine_embeds": "concat",
      "start_at": 0,
      "end_at": 1,
      "embeds_scaling": "V only",
      "model": ["1", 0],
      "ipadapter": ["8", 0],
      "image": ["9", 0]
    },
    "class_type": "IPAdapterAdvanced",
    "_meta": { "title": "Apply IPAdapter Identity Reference" }
  }
}
